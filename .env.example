# ==========================================================================
#  HRIS — contoh konfigurasi environment
#  Salin menjadi .env lalu isi sesuai lingkungan Anda.
# ==========================================================================

# --- WAJIB ----------------------------------------------------------------

# PostgreSQL. Isi password; database/user harus sudah dibuat pada server.
# DATABASE_URL opsional, menggantikan parameter DB_* jika terisi.
HRIS_DATABASE_URL=
HRIS_DB_HOST=127.0.0.1
HRIS_DB_PORT=5432
HRIS_DB_NAME=hris
HRIS_DB_USER=hris
HRIS_DB_PASSWORD=
HRIS_DB_POOL_MAX=10
# disable untuk jaringan lokal; verify-full untuk remote dengan sertifikat valid.
HRIS_DB_SSL=disable
HRIS_DB_SSL_CA_FILE=
# Hanya dipakai compose.yml/compose.image.yml (PostgreSQL 18): password superuser `postgres`
# di container database. Aplikasi memakai HRIS_DB_USER yang bukan superuser.
POSTGRES_ADMIN_PASSWORD=

# Hanya untuk importer data lama, tidak pernah dibaca runtime aplikasi.
MIGRATION_MONGODB_URI=
MIGRATION_MONGODB_URI_DIRECT=
MIGRATION_SOURCE_FROZEN=false

# Kunci penanda tangan sesi. WAJIB diisi dan hanya dipakai untuk sesi.
# Buat dengan: openssl rand -base64 48
NEXTAUTH_SECRET=
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Kunci terpisah berikut WAJIB di produksi. Jangan samakan nilainya dengan
# secret sesi. Mengganti ENCRYPTION_KEY setelah sistem berisi data memerlukan
# prosedur rotasi karena data lama tidak akan dapat dibaca dengan kunci baru.

# Kunci enkripsi data sensitif (NIK, NPWP, rekening, descriptor wajah).
ENCRYPTION_KEY=

# Kunci khusus untuk menandatangani URL berkas privat.
STORAGE_SIGNING_SECRET=

# Kredensial bootstrap untuk `npm run seed` / `node db-seed.cjs`; tidak memiliki nilai bawaan.
# SEED_ADMIN_EMAIL kosong = admin@hris.com. Akun demo karyawan (budi@hris.com) hanya dibuat
# di luar produksi dan hanya jika SEED_STAFF_PASSWORD diisi (minimal 12 karakter).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
# Hanya seed:demo nonproduksi. Kosong memakai default demo yang didokumentasikan.
DEMO_EMPLOYEE_PASSWORD=

# Endpoint /search kompatibel Nominatim, HTTPS; kosong = cari cabang tersimpan/koordinat saja.
# Untuk skala perusahaan gunakan penyedia komersial atau self-hosted.
GEOCODING_SEARCH_URL=
# Identitas aplikasi beserta kontak pengelola yang valid, sesuai persyaratan penyedia.
GEOCODING_USER_AGENT=
# true hanya setelah menyetujui https://operations.osmfoundation.org/policies/nominatim/
GEOCODING_PUBLIC_NOMINATIM_ACK=false

# Kunci yang harus dikirim penjadwal (cron) ke /api/v1/cron/daily.
# Tanpa ini, tugas harian dinonaktifkan sepenuhnya.
# Contoh pemanggilan:
#   curl -H "x-cron-secret: $CRON_SECRET" https://host/api/v1/cron/daily
CRON_SECRET=

# --- PENYIMPANAN BERKAS -----------------------------------------------------
# Pilih salah satu: local | cloudinary | supabase | r2 | minio | b2
STORAGE_PROVIDER=local

# PENTING: direktori ini harus berada DI LUAR folder public/.
# Berkas di dalam public/ disajikan statis oleh Next.js sehingga foto presensi
# dan slip gaji dapat dibuka siapa pun yang menebak alamatnya.
LOCAL_STORAGE_PATH=./storage/uploads

# --- CLOUDINARY (free tier ~25GB) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- SUPABASE STORAGE ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=

# --- CLOUDFLARE R2 (S3-compatible, tanpa egress fee) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- MINIO (self-hosted, S3-compatible) ---
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=

# --- BACKBLAZE B2 ---
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=

# --- NOTIFIKASI -------------------------------------------------------------
# Kanal email/WhatsApp dinyalakan atau dimatikan dari CMS (Pengaturan →
# Notifikasi). Bagian ini hanya menyediakan kredensial pengirimnya.

# Provider email: smtp | resend | webhook
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
RESEND_API_KEY=

# Provider WhatsApp: fonnte | twilio | qontak | webhook | none
WA_PROVIDER=none
FONNTE_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Dipakai bila EMAIL_PROVIDER atau WA_PROVIDER bernilai "webhook".
# Payload dikirim sebagai JSON POST.
NOTIFICATION_WEBHOOK_URL=

# Mekari Qontak (wajib bila WA_PROVIDER=qontak)
QONTAK_API_TOKEN=
QONTAK_CHANNEL_INTEGRATION_ID=
QONTAK_TEMPLATE_ID=
# QONTAK_BASE_URL=
# QONTAK_DEFAULT_TO_NAME=
# QONTAK_LANGUAGE_CODE=

# --- API PUBLIK & ANTI-BOT --------------------------------------------------

# Kunci untuk situs lain yang mengirim lamaran ke POST /api/v1/public/candidates
# lewat header x-api-key. Kosongkan bila hanya halaman karir sendiri yang dipakai.
PUBLIC_API_KEY=

# Cloudflare Turnstile pada form publik. Bila kosong, hanya rate limit per IP
# yang melindungi form lamaran.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- INFRASTRUKTUR (opsional) ------------------------------------------------

# Jumlah reverse proxy tepercaya di depan aplikasi: 1 untuk Dokploy/Traefik atau nginx,
# 2 untuk Cloudflare → Traefik. Kosong/0 = tidak ada. IP klien (rate limit, audit) diambil
# dari entri X-Forwarded-For milik proxy tersebut, bukan entri paling kiri yang bisa dipalsukan.
TRUST_PROXY=

# Jumlah worker verifikasi wajah. Bawaan: setengah jumlah core CPU, maks 4.
FACE_WORKERS=

# --- LISENSI SELF-HOSTED ----------------------------------------------------
# Website lisensi (HTTPS). Dipakai menu Lisensi & Paket untuk aktivasi license key,
# perpanjangan lease, dan membuat perintah upgrade ke Pro. Installer mengisinya otomatis.
HRIS_LICENSE_SERVER=
# Hanya jika memakai agent lifecycle opsional (compose.lifecycle.yml): token acak
# minimal 32 karakter agar agent dapat membaca lease dari aplikasi.
HRIS_AGENT_TOKEN=
# Hanya untuk development lokal; sengaja tidak berfungsi pada NODE_ENV=production.
LICENSE_BYPASS_FOR_DEVELOPMENT=false

# OIDC/OAuth2 SSO (Pro). Pengguna harus sudah memiliki akun HRIS aktif dengan
# email yang sama. Jangan aktifkan tombol sebelum provider terkonfigurasi.
NEXT_PUBLIC_SSO_ENABLED=false
OIDC_NAME=SSO Perusahaan
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Antrean tugas. Kosong = antrean di dalam proses (cukup untuk satu server).
REDIS_URL=
REDIS_HOST=
