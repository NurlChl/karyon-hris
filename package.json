{
  "name": "@hris/community",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "seed": "tsx --env-file=.env src/scripts/seed.ts",
    "seed:demo:plan": "tsx --env-file=.env src/scripts/seed-demo.ts",
    "seed:demo": "tsx --env-file=.env src/scripts/seed-demo.ts --apply",
    "build:db": "node scripts/build-db-tools.mjs",
    "test:api-docs": "tsx --tsconfig tsconfig.json --test src/lib/openapi.test.ts",
    "test:birthdays": "tsx --tsconfig tsconfig.json --test src/lib/hr/birthdays.test.ts",
    "test:security": "tsx --tsconfig tsconfig.json --test src/lib/api.security.test.ts src/lib/crypto.security.test.ts src/lib/rbac/scope.security.test.ts src/lib/storage/LocalProvider.security.test.ts src/lib/integrations/api-scopes.security.test.ts src/lib/export/export.security.test.ts",
    "db:plan": "tsx --tsconfig tsconfig.json scripts/postgres.ts --app=hris --action=plan",
    "db:migrate": "tsx --tsconfig tsconfig.json --env-file=.env scripts/postgres.ts --app=hris --action=apply",
    "db:check": "tsx --tsconfig tsconfig.json --env-file=.env scripts/postgres.ts --app=hris --action=check",
    "db:import": "tsx --tsconfig tsconfig.json --env-file=.env scripts/migrate-mongodb-to-postgres.ts --app=hris",
    "db:cleanup": "tsx --tsconfig tsconfig.json --env-file=.env scripts/postgres.ts --app=hris --action=cleanup",
    "test:postgres": "tsx --tsconfig tsconfig.json --test packages/database/database.test.ts src/lib/postgres.test.ts scripts/migration-values.test.ts"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "framer-motion": "13.4.1",
    "leaflet": "1.9.4",
    "lucide-react": "1.47.0",
    "next": "16.3.6",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "10.0.10",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.6",
    "mongoose": "9.10.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
